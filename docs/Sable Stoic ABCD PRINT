function detectBias(text) {
  const lower = text.toLowerCase();
  const bullCount = (lower.match(/bull|buy|long|up|support|bz/g) || []).length;
  const bearCount = (lower.match(/bear|sell|short|down|resist|sz/g) || []).length;
  if (bullCount > bearCount) return "BULLISH";
  if (bearCount > bullCount) return "BEARISH";
  return "NEUTRAL";
}

function extractElements(text) {
  const lower = text.toLowerCase();
  const found = [];
  Object.entries(keywordMap).forEach(([kw, tag]) => {
    if (lower.includes(kw) && !found.includes(tag)) found.push(tag);
  });
  return found;
}

function buildAnalysis(text, bias, elements) {
  const steps = [];

  if (elements.includes("C")) {
    steps.push({ phase: "1. CONSOLIDATION IDENTIFIED", detail: "A range/consolidation zone has been detected. Mark the HIGH and LOW of this range clearly on your chart.", color: COLORS.blue });
  }
  if (elements.includes("BREAKOUT")) {
    steps.push({ phase: "2. BREAKOUT CONFIRMED", detail: "Price has broken out of the range. Place an ALERT on the side it broke from — wait for the retracement to trigger it.", color: COLORS.accent });
  }
  if (elements.includes("ALERT")) {
    steps.push({ phase: "3. ALERT MANAGEMENT", detail: "Alert placed at the broken High/Low. Once triggered, shift focus to lower timeframes (15M → 5M C).", color: COLORS.silver });
  }
  if (elements.includes("CCI")) {
    steps.push({ phase: "4. CCI ZONE CHECK", detail: bias === "BULLISH" ? "CCI must be in BZ (-180) for bullish bias. Confirm before entry." : bias === "BEARISH" ? "CCI must be in SZ for bearish bias. Do not enter on CZ readings." : "Check CCI zone: BZ (-180) for buys, SZ for sells, CZ (0.0) for continuation only.", color: elements.includes("BULLISH") ? COLORS.green : COLORS.red });
  }
  if (elements.includes("OB") || elements.includes("FVG") || elements.includes("BB")) {
    steps.push({ phase: "5. HTF AOI CONFIRMED", detail: `Structure found: ${[elements.includes("OB") && "OrderBlock", elements.includes("FVG") && "FVG/GAP", elements.includes("BB") && "Breaker Block"].filter(Boolean).join(", ")}. This is your Daily/4H/1H Area of Interest.`, color: COLORS.accent });
  }

  steps.push({
    phase: "6. LTF ENTRY EXECUTION",
    detail: bias === "BULLISH"
      ? "Drop to 1M. Wait for Consolidation → Breakout → Alert placed → Alert triggered → Enter FULL MARGIN on the 1M AOI (OB/BB/FVG)."
      : bias === "BEARISH"
      ? "Drop to 1M. Wait for Consolidation → Breakdown → Alert placed → Alert triggered → Enter FULL MARGIN SHORT on the 1M AOI."
      : "Identify bias on HTF first. Then drill to 1M for the C+O+CCI sniper entry.",
    color: bias === "BULLISH" ? COLORS.green : bias === "BEARISH" ? COLORS.red : COLORS.muted,
  });

  return steps;
}

